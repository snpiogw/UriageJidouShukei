POSTGRES_DB=sales_aggregation
POSTGRES_USER=sales_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/sales_aggregation
DB_USERNAME=sales_app
DB_PASSWORD=change-me
ADMIN_USERNAME=admin
# Generate with: htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
ADMIN_PASSWORD_HASH='$2y$12$replace_with_a_bcrypt_hash'
SESSION_COOKIE_SECURE=false
# Optional: only used once when migrating the legacy profile from V3 or earlier.
GOOGLE_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
SHEETS_CONNECT_TIMEOUT_MILLIS=5000
SHEETS_READ_TIMEOUT_MILLIS=30000
EXECUTION_HISTORY_DAYS=180
EXECUTION_CLEANUP_CRON='0 15 3 * * *'
