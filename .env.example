# Generate with: htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
ADMIN_PASSWORD_HASH='$2y$12$replace_with_a_bcrypt_hash'
SESSION_COOKIE_SECURE=false
GOOGLE_SPREADSHEET_ID=replace-me
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
